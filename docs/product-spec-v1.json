        },
        "statuses": [
            "REQUESTED",
            "CONFIRMED",
            "SCHEDULED",
            "IN_PROGRESS",
            "COMPLETED",
            "CANCELLED",
            "RESCHEDULED",
            "NO_SHOW"
        ],
        "credit_rules": {
            "completed": true,
            "client_cancelled": false,
            "trainer_cancelled": false,
            "client_no_show": false,
            "trainer_no_show": false,
            "rescheduled": false,
            "own_workout": false
        }
    },
    "cancellation_policy": {
        "configurable_by_trainer": true,
        "modes": [
            "NO_PENALTY",
            "FOUR_HOUR_POLICY",
            "CUSTOM"
        ],
        "four_hour_policy": {
            "cancelled_at_least_four_hours_before": {
                "deduct_credit": false
            },
            "cancelled_within_four_hours": {
                "deduct_credit": true
            }
        },
        "default": "NO_PENALTY"
    },
