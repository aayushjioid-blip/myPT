        "offline_payment_methods": [
            "UPI_ID",
            "MOBILE_NUMBER"
        ],
        "payment_flow": [
            "DISPLAY_TRAINER_PAYMENT_DETAILS",
            "CLIENT_PAYS_EXTERNALLY",
            "CLIENT_CLICKS_I_HAVE_PAID",
            "PAYMENT_PENDING_VERIFICATION",
            "TRAINER_VERIFIES",
            "PACKAGE_ACTIVATED"
