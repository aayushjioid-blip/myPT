{
    "project": {
        "name": "Fitness Trainer Platform",
        "working_title": "FitTrainer",
        "version": "1.0",
        "status": "MVP_SPECIFICATION",
        "description": "A trainer-first fitness management platform for independent personal trainers, with support for future gym-based organizations, head trainers, trainers and clients.",
        "primary_platform": "mobile",
        "recommended_frontend": "Flutter",
        "recommended_backend": "Supabase",
        "recommended_database": "PostgreSQL",
        "recommended_storage": "Supabase Storage",
        "recommended_web_deployment": "Vercel",
        "themes": [
            "light",
            "dark"
        ]
    },
    "product_principles": [
        "The platform is trainer-first rather than gym-first.",
        "A trainer can operate independently without belonging to a gym.",
        "A trainer may later associate with one or more gyms.",
        "A client must have an accepted trainer relationship before accessing trainer-specific functionality.",
        "Clients cannot independently switch trainers when operating under an independent trainer.",
        "Within a gym, the head trainer or authorized gym management can reassign clients.",
        "A completed personal training session consumes exactly one package session credit.",
        "Cancelled, rescheduled or no-show sessions do not consume a session credit unless a configured cancellation policy applies.",
        "Own workouts performed by clients never consume personal training credits.",
        "Database-level authorization must enforce all role permissions.",
        "Feature flags controlled by Super Admin should allow future functionality to be enabled without redesigning the application."
    ],
    "roles": {
        "SUPER_ADMIN": {
            "description": "Platform administrator with global control.",
            "scope": "GLOBAL"
        },
        "GYM_MANAGER": {
            "description": "Person responsible for managing a gym organization.",
            "scope": "GYM"
        },
        "HEAD_TRAINER": {
            "description": "Senior trainer responsible for managing trainers and client assignments within a gym.",
            "scope": "GYM"
        },
        "TRAINER": {
            "description": "Personal trainer who can independently manage clients or work under one or more gyms.",
            "scope": "TRAINER_OR_GYM"
        },
        "CLIENT": {
            "description": "End customer receiving personal training services.",
            "scope": "SELF"
        }
    },
    "organization_model": {
        "organization_types": [
            "INDEPENDENT_TRAINER",
            "GYM"
        ],
        "independent_model": {
            "trainer_required": true,
            "gym_required": false
        },
        "gym_model": {
            "gym_required": true,
            "roles": [
                "GYM_MANAGER",
                "HEAD_TRAINER",
                "TRAINER",
                "CLIENT"
            ]
        },
        "trainer_membership": {
            "can_be_independent": true,
            "can_belong_to_multiple_gyms": true
        }
    },
    "authentication": {
        "methods": [
            "MOBILE_OTP",
            "GOOGLE"
        ],
        "signup_roles": [
            "TRAINER",
            "GYM_MANAGER",
            "CLIENT"
        ],
        "test_accounts": {
            "enabled": true,
            "bypass_payment": true,
            "bypass_subscription": true,
            "bypass_trial_restrictions": true,
            "bypass_verification": true
        }
    },
    "trainer_onboarding": {
        "steps": [
            "authentication",
            "basic_profile",
            "professional_profile",
            "specializations",
            "services",
            "availability",
            "payment_information",
            "trial_or_subscription",
            "profile_completion"
        ],
        "profile_fields": [
            "name",
            "profile_photo",
            "bio",
            "experience_years",
            "certifications",
            "specializations",
            "languages",
            "location",
            "training_style",
            "services",
            "contact_information"
        ],
        "verification": {
            "required_for_app_usage": false,
            "required_for_public_discovery": true,
            "admin_controlled": true
        }
    },
    "client_onboarding": {
        "steps": [
            "authentication",
            "basic_profile",
            "optional_personal_information",
            "trainer_discovery"
        ],
        "personal_information": {
            "enabled_by_super_admin": true,
            "client_opt_in_required": true,
            "sharing_label": "Share with my trainer",
            "fields": [
                "age",
                "height",
                "weight",
                "fitness_goal",
                "fitness_level",
                "injuries",
                "medical_information",
                "exercise_restrictions",
                "dietary_information",
                "emergency_contact"
            ]
        },
        "trainer_access": {
            "required": true,
            "accepted_relationship_required": true
        }
    },
    "trainer_discovery": {
        "enabled": true,
        "mvp_methods": [
            "SEARCH_BY_NAME",
            "TRAINER_LIST",
            "QR_CODE",
            "TRAINER_CODE"
        ],
        "advanced_search": {
            "feature_flag": "advanced_trainer_search",
            "default_enabled": false,
            "controlled_by": "SUPER_ADMIN",
            "future_filters": [
                "location",
                "experience",
                "specialization",
                "training_type",
                "availability",
                "price_range",
                "gender",
                "language"
            ]
        },
        "visibility_rules": {
            "verified_trainers": "PUBLIC_DISCOVERY",
            "unverified_trainers": "NOT_PUBLICLY_DISCOVERABLE",
            "unverified_trainers_can_use_app": true
