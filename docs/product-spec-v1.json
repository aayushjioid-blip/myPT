                "name",
                "bio",
                "experience",
                "certifications",
                "specializations",
                "languages",
                "location",
                "training_style",
                "services",
                "packages",
                "pricing",
                "availability",
                "reviews",
                "rating",
                "verification_status"
            ]
        },
        "trainer_qr": {
            "enabled": true,
            "purpose": "Client can scan QR to identify trainer."
        },
        "trainer_code": {
            "enabled": true,
            "unique_per_trainer": true
        }
    },
    "client_trainer_relationship": {
        "initial_relationship": "ONE_ACTIVE_TRAINER",
        "relationship_states": [
            "REQUESTED",
            "PENDING",
            "ACCEPTED",
            "REJECTED",
            "SUSPENDED",
            "ENDED",
            "REASSIGNED"
        ],
        "independent_trainer": {
            "client_can_switch_trainer": false,
            "trainer_can_reassign": false
        },
        "gym": {
            "client_can_switch_trainer": false,
            "head_trainer_can_reassign": true,
            "gym_manager_can_reassign": true
        },
        "history": {
            "preserve_previous_trainer_history": true
        }
    },
    "consultation_flow": {
        "purpose": "Allow a prospective client to express interest in a trainer before purchasing a package.",
        "flow": [
            "CLIENT_VIEWS_TRAINER",
            "CLIENT_VIEWS_SERVICES",
            "CLIENT_VIEWS_PACKAGES",
            "CLIENT_CLICKS_INTERESTED",
            "CONSULTATION_REQUEST_CREATED",
            "TRAINER_RECEIVES_NOTIFICATION",
            "TRAINER_ACCEPTS_OR_REJECTS",
            "TRAINER_AND_CLIENT_DISCUSS_REQUIREMENTS",
            "TRAINER_APPROVES_CLIENT",
            "CLIENT_SELECTS_PACKAGE",
            "CLIENT_COMPLETES_PAYMENT",
            "PACKAGE_ACTIVATED"
        ],
        "mvp": {
            "calendar_based_consultation": false,
            "consultation_as_request": true
        }
    },
    "packages": {
        "created_by": [
            "TRAINER",
            "HEAD_TRAINER"
        ],
        "fields": [
            "name",
            "description",
            "number_of_sessions",
            "price",
            "validity_days",
            "validity_mode",
            "session_duration",
            "status"
        ],
        "validity": {
            "default_mode": "SESSIONS_MULTIPLIED_BY_4",
            "customization": true,
            "supported_modes": [
                "SESSIONS_MULTIPLIED_BY_4",
                "SESSIONS_MULTIPLIED_BY_3",
                "FIXED_DAYS",
                "CUSTOM"
            ],
            "example": {
                "sessions": 10,
                "default_validity_days": 40
            }
        },
        "package_status": [
            "DRAFT",
            "ACTIVE",
            "INACTIVE",
            "EXPIRED",
            "SOLD_OUT"
        ]
    },
    "package_purchase": {
        "preconditions": [
            "CLIENT_HAS_ACCEPTED_TRAINER_RELATIONSHIP",
            "TRAINER_APPROVED_CLIENT",
            "PACKAGE_IS_ACTIVE"
        ],
        "flow": [
            "CLIENT_SELECTS_PACKAGE",
            "PAYMENT_METHOD_DISPLAYED",
            "CLIENT_MAKES_PAYMENT",
            "CLIENT_SUBMITS_PAYMENT_CONFIRMATION",
            "PAYMENT_STATUS_PENDING_VERIFICATION",
            "TRAINER_VERIFIES_PAYMENT",
            "PACKAGE_ACTIVATED"
        ],
        "session_balance": {
            "initial_balance": "NUMBER_OF_PURCHASED_SESSIONS",
            "decrement_condition": "SESSION_COMPLETED",
            "zero_balance_blocks_new_pt_booking": true
        }
    },
    "payments": {
        "mvp": {
            "online_gateway": false,
            "offline_payment": true
